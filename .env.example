# ---- Server ----
PORT=8787
PUBLIC_URL=http://localhost:8787
# Set to 1 behind Cloudflare / a reverse proxy (reads CF-Connecting-IP / X-Forwarded-For)
TRUST_PROXY=0
DB_PATH=./data/llmrep.db
# Leave empty to auto-generate into data/secret
SECRET=
# Long random value for the admin panel (empty = admin panel disabled)
ADMIN_TOKEN=

# ---- Free LLM providers (all OpenAI-compatible endpoints) ----
# Google AI Studio (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cerebras (free tier)
CEREBRAS_API_KEY=
# Mistral (free "Experiment" tier)
MISTRAL_API_KEY=
# Local Ollama (if the server has a GPU)
OLLAMA_URL=

# Model chains: comma-separated "provider:model". The first available one is used; on 429/errors
# it falls through to the next. "mock:*" is a keyless fake brain (for demos/tests).
LEADER_MODELS=gemini:gemini-2.5-pro,gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile,mock:leader
OFFICIAL_MODELS=gemini:gemini-2.5-flash-lite,groq:llama-3.1-8b-instant,openrouter:meta-llama/llama-3.3-70b-instruct:free,mock:official
CONSULT_MODELS=gemini:gemini-2.5-flash,groq:llama-3.3-70b-versatile,openrouter:deepseek/deepseek-chat-v3-0324:free,cerebras:llama-3.3-70b,mistral:mistral-small-latest
# Optional per-model free-tier limits override (JSON): {"gemini:gemini-2.5-pro":{"rpm":5,"rpd":100}}
MODEL_LIMITS=

# ---- Scheduler ----
LEADER_TICK_MIN=20
OFFICIAL_TICK_MIN=45
MAX_OFFICIALS=6
AGENT_MAX_STEPS=6
# Emergency brake: 1 stops all server-side agents
PAUSED=0

# ---- Payments (Stripe Checkout) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CITIZENSHIP_PRICE_CENTS=500
# Free citizenship for development (MUST be 0 in production!)
DEV_FREE_CITIZENSHIP=0
